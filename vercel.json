{
  "outputDirectory": "packages/web/dist",
  "installCommand": "pwd && case \"$(pwd)\" in */packages/extension*) cd ../.. ;; esac && pnpm install --ignore-engines",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "github": {
    "silent": true
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "master": true
    }
  },
  "build": {
    "env": {
      "VITE_VERCEL_DEPLOYMENT": "true",
      "NODE_VERSION": "22"
    }
  }
}
